{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsport-express",
  // Pinned so this project can only ever deploy to the NewsPort Express
  // Cloudflare account (shivamsubhash123@gmail.com), whoever is logged in.
  "account_id": "c1973129021e4970defdffe7c04de518",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-10-01",
  // nodejs_compat is required by postgres.js, which reaches Supabase over
  // cloudflare:sockets on the workerd build.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "newsport-express" }],
  "observability": { "enabled": true },
  // Run the Worker next to the database (Supabase, Mumbai) rather than next to
  // each reader: a page makes many queries, so database distance dominates.
  "placement": { "mode": "smart" },
  // Hyperdrive pools connections and terminates TLS on Cloudflare's side.
  // workerd rejects Supabase's *.pooler.supabase.com certificate, so the Worker
  // cannot reach Postgres directly; it talks to Hyperdrive instead.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "e7ff88241604427b8b9e62448e9a2194" }],
  "vars": {
    // The live origin. Change this when a custom domain is attached: it drives
    // canonical URLs, sitemaps, Open Graph tags and the secure session cookie.
    "SITE_URL": "https://newsport-express.newsport-express.workers.dev",
    "SITE_NAME": "NewsPort Express",
    "SUPABASE_MEDIA_BUCKET": "media",
    // Not a secret: the project URL is public in any Supabase client.
    "SUPABASE_URL": "https://uzgwnugklxldbkyfvkrk.supabase.co"
  }
  // Secrets are never committed. Set them with `wrangler secret put <NAME>`:
  //   DATABASE_URL           Supabase Supavisor transaction pooler URI (port 6543)
  //   SUPABASE_SECRET_KEY    sb_secret_... ; bypasses RLS, server-side only
  //   SETUP_TOKEN            one-time token guarding /admin/setup
  // ./scripts/push-secrets.sh pushes all three from .dev.vars.
}
