{
  "name": "newsport-express",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.dev.vars node_modules/drizzle-kit/bin.cjs migrate",
    "db:rls": "node --env-file=.dev.vars db/run-sql.mjs db/rls.sql",
    "db:seed": "node --env-file=.dev.vars db/run-sql.mjs db/seed.sql",
    "db:setup": "npm run db:migrate && npm run db:rls && npm run db:seed",
    "preview": "./scripts/cf.sh npx opennextjs-cloudflare build && ./scripts/cf.sh npx opennextjs-cloudflare preview",
    "deploy": "./scripts/cf.sh npx opennextjs-cloudflare build && ./scripts/cf.sh npx opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars false cloudflare-env.d.ts",
    "db:verify": "node --experimental-strip-types --no-warnings db/verify.mjs",
    "db:local": "node db/local-postgres.mjs",
    "db:verify-retry": "node --experimental-strip-types --no-warnings db/verify-retry.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.168.0"
  }
}
